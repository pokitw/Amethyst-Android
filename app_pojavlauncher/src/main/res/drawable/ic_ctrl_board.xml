<!--
    An on-screen control glyph. Solid shapes rather than the 1.8dp strokes of the ic_x_* set:
    these are drawn thumb-sized over gameplay, where a hairline vanishes against a bright sky.
    White so the caller tints, like every other icon here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
        The launcher's own on-screen keyboard, distinct from ic_ctrl_keyboard which raises the
        system IME. The rising caret is the difference: this board comes up from the bottom.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M2,9.6 H22 V20 H2 Z M4.4,11.8 H6.8 V13.8 H4.4 Z M8.2,11.8 H10.6 V13.8 H8.2 Z M12,11.8 H14.4 V13.8 H12 Z M15.8,11.8 H19.6 V13.8 H15.8 Z M4.4,15.4 H7 V17.4 H4.4 Z M8.4,15.4 H15.6 V17.4 H8.4 Z M17,15.4 H19.6 V17.4 H17 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,2.2 L16.4,7 H7.6 Z" />
</vector>
