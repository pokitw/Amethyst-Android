<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_height="match_parent"
	android:layout_width="match_parent"
	android:layout_alignParentRight="true"
	android:id="@+id/main_drawer_options"
	android:background="@drawable/no_focus_shown"
	android:keepScreenOn="true">

	<FrameLayout
		android:id="@+id/content_frame"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<net.kdt.pojavlaunch.customcontrols.ControlLayout
			android:id="@+id/main_control_layout"
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<View style="@style/DimensionTracker"/>

			<net.kdt.pojavlaunch.MinecraftGLSurface
				android:id="@+id/main_game_render_view"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:defaultFocusHighlightEnabled="false"
                tools:ignore="UnusedAttribute" />

			<net.kdt.pojavlaunch.customcontrols.mouse.Touchpad
				android:layout_height="match_parent"
				android:layout_width="match_parent"
				android:orientation="vertical"
				android:id="@+id/main_touchpad"
				android:focusable="false"
				android:translationZ="1dp"
				android:visibility="gone"/>

		<!-- This is a horrible hack that forces android to properly redraw ControlLayout
			 when keyboard causes MainActivity to pan offscreen, which can cause the top part
			 of ControLayout to just be grpahically cut out. This stops that, somehow...      -->
			<View
				android:layout_height="match_parent"
				android:layout_width="match_parent"
				android:orientation="vertical"
				android:focusable="false"
				android:translationZ="1dp"
				android:visibility="visible"
				android:importantForAccessibility="no"
				android:background="@android:color/transparent"/>

			<net.kdt.pojavlaunch.customcontrols.keyboard.TouchCharInput
				android:id="@+id/mainTouchCharInput"
				android:layout_width="1dp"
				android:layout_height="1dp"
				android:layout_gravity="bottom"
				android:background="@android:color/darker_gray"
				android:ems="10"
				android:imeOptions="flagNoFullscreen|flagNoExtractUi|flagNoPersonalizedLearning|actionDone"
				android:inputType="textFilter|textImeMultiLine|textAutoComplete|textAutoCorrect"
				tools:ignore="TouchTargetSizeCheck" />

			<net.kdt.pojavlaunch.utils.TouchControllerInputView
				android:id="@+id/touch_controller_input"
				android:layout_width="1dp"
				android:layout_height="1dp"
				android:layout_gravity="bottom" />

			<net.kdt.pojavlaunch.customcontrols.handleview.DrawerPullButton
				android:id="@+id/drawer_button"
				android:layout_width="40dp"
				android:layout_height="20dp"
				android:padding="8dp"
				android:elevation="10dp"
				android:layout_gravity="center_horizontal"/>
			<net.kdt.pojavlaunch.customcontrols.mouse.HotbarView
				android:id="@+id/hotbar_view"
				android:layout_width="0px"
				android:layout_height="0px"/>

		</net.kdt.pojavlaunch.customcontrols.ControlLayout>

		<!--
			The control editor's panel. Stretched over the layout so it can put itself on whichever
			side the control being edited is not, and GONE while closed: a control layout is a thing
			you drag buttons around on, so a view left visible and empty would swallow every drag.
		-->
		<androidx.compose.ui.platform.ComposeView
			android:id="@+id/control_editor"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone"/>

		<!--
			The live recording pill. Sized to its content and offset clear of the pull tab, so it
			covers as little of the game as possible; it is GONE unless a recording is running.
			Nothing inside it is interactive, so touches fall through to the game below.
		-->
		<androidx.compose.ui.platform.ComposeView
			android:id="@+id/control_center_pill"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="top|center_horizontal"
			android:layout_marginStart="96dp"
			android:layout_marginTop="4dp"
			android:visibility="gone"/>

		<!--
			The launcher's on-screen keyboard, opened straight from a control button.

			Deliberately NOT inside the control center's full-screen view. A keyboard you poke
			mid-fight should leave the game visible and touchable above it, so this is only as
			tall as the board itself and captures touches only inside its own rectangle. That is
			also why it needs no scrim.
		-->
		<androidx.compose.ui.platform.ComposeView
			android:id="@+id/game_keyboard"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom"
			android:visibility="gone"/>

		<!--
			The dictation overlay. Small, bottom-anchored and GONE unless listening, so it covers
			as little of the game as possible and the rest of the screen stays playable while it
			is up. Wrap_content is doing real work here: a match_parent ComposeView would take
			every touch the game is waiting for, which is the rule the control center below obeys
			by being GONE instead.

			After the keyboard rather than before it: both sit at the bottom, and a listening
			indicator hidden behind the board would be worse than one covering a row of it.
		-->
		<androidx.compose.ui.platform.ComposeView
			android:id="@+id/voice_overlay"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom|center_horizontal"
			android:visibility="gone"/>

		<!--
			What is being typed, for when the keyboard is covering the field it is going into.

			Top-anchored and sized to its content, so it takes no touches the game is waiting for
			and covers as little as it can. The margin is what keeps it clear of the recording pill
			above it, and it is also the "a little way down" the strip needs so a camera notch on
			the long edge of a phone held that way up cannot sit on top of it; the composition pads
			itself clear of a reported cutout as well.

			Declared before the screenshot toast on purpose. The two share this band, and z-order is
			the whole of the arbitration: the toast has something to say for two seconds and then
			stops, so it draws over the strip for exactly that long and the strip is still there
			afterwards. Neither needs to know the other exists.

			This is also the one view here that must not ride the keyboard pan, since it exists
			because of it. TypingPreviewHost.applyPan cancels the frame's translation out.
		-->
		<androidx.compose.ui.platform.ComposeView
			android:id="@+id/typing_preview"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="top|center_horizontal"
			android:layout_marginTop="44dp"
			android:visibility="gone"/>

		<!--
			The word that a screenshot was taken. Nothing else on screen changes when one is, so
			without this the only way to find out whether the button worked is to leave the game.

			Top-anchored and sized to its content: the bottom belongs to the keyboard and the
			dictation overlay, and both thumbs. The margin drops it clear of the recording pill so
			the two stack rather than overlap while a recording is running. GONE unless it is
			saying something, like everything else over this surface, and it takes no touches.
		-->
		<androidx.compose.ui.platform.ComposeView
			android:id="@+id/screenshot_toast"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="top|center_horizontal"
			android:layout_marginTop="44dp"
			android:visibility="gone"/>

		<!--
			The shutter, for framing a screenshot with the game actually in view.

			Anchored to the right edge because that is the one part of the screen the default
			layout leaves alone: the top row and both bottom corners are full of buttons, and the
			middle is where you are looking.

			Lifted 40dp above the vertical centre, which is not decoration. FrameLayout offsets a
			centred child by (topMargin - bottomMargin), and dead centre on a short landscape
			screen lands on top of the sneak button — the free band on that edge runs from under
			the top row down to the bottom cluster, and its middle is above the screen's.

			Sized to its content, so the rest of the screen stays playable. A match_parent view
			here would take every touch the game is waiting for (§12.9), which is also why it
			cannot simply be dragged anywhere.
		-->
		<androidx.compose.ui.platform.ComposeView
			android:id="@+id/screenshot_shutter"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="end|center_vertical"
			android:layout_marginBottom="40dp"
			android:visibility="gone"/>

		<!--
			The control center itself. Stretched over the game, so it stays GONE while closed:
			visible it would sit in front of every touch the game is waiting for.
		-->
		<androidx.compose.ui.platform.ComposeView
			android:id="@+id/control_center"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone"/>

		<com.kdt.LoggerView
			android:id="@+id/mainLoggerView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone"
			/>

	</FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>

