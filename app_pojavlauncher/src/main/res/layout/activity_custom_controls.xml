<?xml version="1.0" encoding="utf-8"?>
<!--
	The control layout editor.

	It used to be a DrawerLayout holding a 200dp ListView of plain text rows — the same shape the
	in-game menu had before it became the control center. Both are the control center now, so the
	editor reached from Settings and the editor reached from inside the game are one screen with
	two ways in, rather than two screens that happened to do the same seven things.
-->
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<net.kdt.pojavlaunch.customcontrols.ControlLayout
		android:id="@+id/customctrl_controllayout"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<net.kdt.pojavlaunch.customcontrols.handleview.DrawerPullButton
			android:id="@+id/drawer_button"
			android:layout_width="40dp"
			android:layout_height="20dp"
			android:padding="6dp"
			android:elevation="10dp"
			android:layout_gravity="center_horizontal" />

	</net.kdt.pojavlaunch.customcontrols.ControlLayout>

	<!--
		The control editor's panel. Stretched over the layout so it can put itself on whichever side
		the control being edited is not, and GONE while closed: a control layout is a thing you drag
		buttons around on, so a view left visible and empty would swallow every drag.
	-->
	<androidx.compose.ui.platform.ComposeView
		android:id="@+id/control_editor"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:visibility="gone" />

	<!--
		Never shown here — the editor cannot record — but the control center host takes both views,
		and handing it a real one costs less than making its contract optional.
	-->
	<androidx.compose.ui.platform.ComposeView
		android:id="@+id/control_center_pill"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="top|center_horizontal"
		android:visibility="gone" />

	<!--
		The test session's panel. wrap_content and pinned to the top, unlike every other view here,
		and that is the whole design: a test session exists so the buttons underneath can be
		pressed, so a full-size view over them would take away the one thing it is for. It covers
		whatever sits top centre, which is why it collapses.
	-->
	<androidx.compose.ui.platform.ComposeView
		android:id="@+id/control_test"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="top|center_horizontal"
		android:visibility="gone" />

	<!--
		Stretched over the editor, so it stays GONE while closed: visible it would sit in front of
		every drag the buttons underneath are waiting for.
	-->
	<androidx.compose.ui.platform.ComposeView
		android:id="@+id/control_center"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:visibility="gone" />

</FrameLayout>
