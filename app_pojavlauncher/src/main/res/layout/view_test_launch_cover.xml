<?xml version="1.0" encoding="utf-8"?>
<!--
	The cover the launcher wears while a test launch passes through it.

	The editor finishes, the launcher raises the launch, the downloader verifies, and the game
	process comes up; all of that used to happen in full view, which is what made the test feel
	like three apps instead of one. This sits over everything for those few seconds, in the same
	visual language as the splash: the gem, on the launcher's own ground.

	Plain views on purpose. It exists during the exact window in which the launcher process is
	about to be killed, so it wants nothing that can be half-initialised.
-->
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/background_app"
	android:clickable="true"
	android:focusable="true"
	android:elevation="30dp">

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:orientation="vertical"
		android:gravity="center_horizontal">

		<ImageView
			android:layout_width="72dp"
			android:layout_height="72dp"
			android:importantForAccessibility="no"
			android:src="@drawable/ic_splash_gem" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="18dp"
			android:text="@string/test_launch_cover_title"
			android:textColor="@color/primary_text"
			android:textSize="17sp"
			android:textStyle="bold" />

		<ProgressBar
			android:layout_width="26dp"
			android:layout_height="26dp"
			android:layout_marginTop="16dp"
			android:indeterminate="true"
			android:indeterminateTint="@color/dialog_accent" />

		<TextView
			android:id="@+id/test_launch_cover_hint"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="26dp"
			android:text="@string/test_launch_cover_hint"
			android:textColor="@color/secondary_text"
			android:textSize="13sp"
			android:visibility="gone" />

	</LinearLayout>

</FrameLayout>
