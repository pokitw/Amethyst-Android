<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_line"
    android:paddingHorizontal="@dimen/padding_large"
    android:paddingVertical="@dimen/padding_heavy"
    android:layout_marginHorizontal="@dimen/padding_large"
    android:layout_marginVertical="@dimen/padding_moderate"
    android:minHeight="@dimen/_60sdp">

    <FrameLayout
        android:id="@+id/recording_thumbnail"
        android:layout_width="@dimen/_48sdp"
        android:layout_height="@dimen/_48sdp"
        android:background="@drawable/recording_thumbnail_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/padding_heavy"
            android:src="@drawable/ic_recording_play"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <TextView
        android:id="@+id/recording_title"
        style="@style/TextAppearance.AppCompat.Body1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_large"
        android:layout_marginEnd="@dimen/padding_medium"
        android:textColor="@color/primary_text"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/recording_thumbnail"
        app:layout_constraintEnd_toStartOf="@id/recording_overflow"
        app:layout_constraintTop_toTopOf="@id/recording_thumbnail"
        app:layout_constraintHorizontal_bias="0"
        tools:text="29 Jul · 14:32" />

    <TextView
        android:id="@+id/recording_subtitle"
        style="@style/TextAppearance.AppCompat.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_large"
        android:layout_marginEnd="@dimen/padding_medium"
        android:layout_marginTop="@dimen/padding_medium"
        android:textColor="@color/secondary_text"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="@id/recording_title"
        app:layout_constraintEnd_toEndOf="@id/recording_title"
        app:layout_constraintTop_toBottomOf="@id/recording_title"
        app:layout_constraintHorizontal_bias="0"
        tools:text="2:14 · 84 MB · 3 hours ago" />

    <ImageButton
        android:id="@+id/recording_overflow"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/padding_medium"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_menu_more_vert"
        android:contentDescription="@string/recordings_action_more"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/recording_thumbnail"
        app:layout_constraintBottom_toBottomOf="@id/recording_thumbnail" />

</androidx.constraintlayout.widget.ConstraintLayout>
