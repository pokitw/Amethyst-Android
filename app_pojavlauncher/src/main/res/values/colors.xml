<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="control_button_color">#4CC4C4C4</color>
    <color name="control_button_pressed_color">#4D000000</color>

    <!--
        The launcher's surfaces, aligned with the Amethyst X ramp in ui/theme/Color.kt so the
        screens that are still built from layouts sit on the same ground as the ones that are not.
        The neutrals carry a little of the brand violet, which is what stops large dark areas
        reading as flat grey next to the accent.
    -->
    <color name="minebutton_color">#9649B8</color>
    <color name="background_app">#0E0B12</color>
    <color name="divider">@color/background_overlay</color>
    <color name="background_overlay">#3A3245</color>
    <!-- Matched to the app background so the status bar reads as part of the page. -->
    <color name="background_status_bar">#0E0B12</color>
    <color name="background_bottom_bar">#16121C</color>

    <color name="primary_text">#E9E2EF</color>
    <color name="secondary_text">#A79DB4</color>

    <!--
        Dialogs. The launcher still shows a couple of dozen AlertDialogs from the parts of it that
        are not Compose yet — errors, confirmations, the crash fallback — and left alone they render
        in stock AppCompat grey with a teal accent, which is the single loudest thing on the screen
        that does not belong to this app. These are the same tokens as ui/theme/Color.kt so a
        dialog sits on the surface ramp the Compose sheets use.
    -->
    <color name="dialog_surface">#1D1826</color>
    <color name="dialog_accent">#C08CE8</color>
    <color name="dialog_scrim">#0E0B12</color>
</resources>
